{
  "version": 2,
  "outputDirectory": "src/frontend",
  "rewrites": [
    { "source": "/", "destination": "/pages/index.html" },
    { "source": "/pages/:match", "destination": "/pages/:match" },
    { "source": "/auth", "destination": "/pages/auth.html" },
    { "source": "/fasal", "destination": "/pages/fasal.html" },
    { "source": "/(.*)", "destination": "/pages/$1" }
  ]
}
